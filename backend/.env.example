JWT_SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./app.db
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 으로 받은 JSON 경로.
# 비워두면 FCM 발송은 로그만 남기고 스킵됨(로컬 개발 시 기본값).
FIREBASE_CREDENTIALS_PATH=
# 법률 에이전트(POST /contracts/{id}/legal-advice)용 — OpenAI SDK 호환 엔드포인트면 어디든 가능
# (Google Gemini, Upstage Solar, Groq 등). 둘 다 없으면 그 엔드포인트만 503으로 응답하고
# 나머지 기능은 정상 동작함.
# 기본값은 Google Gemini 무료 티어(aistudio.google.com에서 키 발급, 카드 등록 안 하면 무료 한도까지만).
LEGAL_LLM_API_KEY=
LEGAL_LLM_MODEL=gemini-3.5-flash
LEGAL_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
