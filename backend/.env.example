JWT_SECRET_KEY=change-me-in-production
# 로컬 개발: 상대경로로 파일 하나. 클라우드 배포(볼륨 마운트 시): 절대경로, 예) sqlite:////data/app.db
DATABASE_URL=sqlite:///./app.db
# 문제접수 사진 업로드가 저장될 폴더. 비워두면 backend/uploads (로컬 개발 기본값).
# 클라우드에 배포할 때는 재배포해도 안 지워지는 영구 볼륨 경로를 넣을 것, 예) /data/uploads
UPLOAD_DIR=
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 으로 받은 JSON.
# 로컬 개발: 파일로 받아서 FIREBASE_CREDENTIALS_PATH에 경로만 지정.
# 클라우드 배포: 파일을 git에 올릴 수 없으니, 받은 JSON 파일의 내용을 통째로 복사해서
# FIREBASE_CREDENTIALS_JSON에 문자열로 붙여넣기(배포 플랫폼의 환경변수 설정 화면에 그대로 입력).
# CREDENTIALS_JSON이 있으면 그걸 우선 쓰고, 없으면 PATH를 씀. 둘 다 없으면 FCM은
# 로그만 남기고 스킵됨(로컬 개발 시 기본값).
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
